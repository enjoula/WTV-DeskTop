{
  "name": "wtv",
  "version": "1.0.0",
  "versionCode": 100,
  "description": "看视频 - WTV Desktop Application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run react-dev\" \"npm run electron-dev\"",
    "react-dev": "cd src/renderer && npm start",
    "electron-dev": "nodemon --exec electron . --watch src/main",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "build:all": "node build-all.js",
    "build:mac": "node build-all.js --mac-only",
    "build:win": "node build-all.js --win-only",
    "build:react": "cd src/renderer && npm run build",
    "build:icon": "node build/convert-icon.js"
  },
  "keywords": [
    "video",
    "vod",
    "desktop",
    "electron",
    "react"
  ],
  "author": "WTV Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-icon-maker": "^0.0.5",
    "nodemon": "^3.1.11",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.wtv.app",
    "productName": "WTV",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icons/icon.png",
    "files": [
      "src/main/**/*",
      "src/renderer/build/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WTV",
      "warningsAsErrors": false,
      "packElevateHelper": false,
      "differentialPackage": false,
      "allowElevation": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}